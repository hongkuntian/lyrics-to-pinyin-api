{
  "version": 2,
  "builds": [
    {
      "src": "api/romanize.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/kuromoji/dict/**",
          "node_modules/kuromoji/NOTICE.md",
          "node_modules/kuromoji/LICENSE-2.0.txt",
          "node_modules/kuroshiro/LICENSE",
          "node_modules/kuroshiro-analyzer-kuromoji/LICENSE",
          "THIRD_PARTY_NOTICES.md"
        ]
      }
    },
    {
      "src": "api/music-romanize.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/kuromoji/dict/**",
          "node_modules/kuromoji/NOTICE.md",
          "node_modules/kuromoji/LICENSE-2.0.txt",
          "node_modules/kuroshiro/LICENSE",
          "node_modules/kuroshiro-analyzer-kuromoji/LICENSE",
          "THIRD_PARTY_NOTICES.md"
        ]
      }
    },
    {
      "src": "api/song-library.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/kuromoji/dict/**",
          "node_modules/kuromoji/NOTICE.md",
          "node_modules/kuromoji/LICENSE-2.0.txt",
          "node_modules/kuroshiro/LICENSE",
          "node_modules/kuroshiro-analyzer-kuromoji/LICENSE",
          "THIRD_PARTY_NOTICES.md"
        ]
      }
    },
    {
      "src": "api/review-reports.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/romanize",
      "dest": "/api/romanize.js"
    },
    {
      "src": "/api/music-romanize",
      "dest": "/api/music-romanize.js"
    },
    {
      "src": "/api/song-library",
      "dest": "/api/song-library.js"
    },
    {
      "src": "/api/review-reports",
      "dest": "/api/review-reports.js"
    }
  ],
  "crons": [
    {
      "path": "/api/review-reports",
      "schedule": "0 8 * * *"
    }
  ]
}
