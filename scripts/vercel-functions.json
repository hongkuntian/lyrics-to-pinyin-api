{
  "entries": [
    {
      "entry": "api/romanize.js",
      "includeFiles": [
        "node_modules/kuromoji/dict/**",
        "node_modules/kuromoji/NOTICE.md",
        "node_modules/kuromoji/LICENSE-2.0.txt",
        "node_modules/kuroshiro/LICENSE",
        "node_modules/kuroshiro-analyzer-kuromoji/LICENSE",
        "THIRD_PARTY_NOTICES.md"
      ]
    },
    {
      "entry": "api/music-romanize.js",
      "includeFiles": [
        "node_modules/kuromoji/dict/**",
        "node_modules/kuromoji/NOTICE.md",
        "node_modules/kuromoji/LICENSE-2.0.txt",
        "node_modules/kuroshiro/LICENSE",
        "node_modules/kuroshiro-analyzer-kuromoji/LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "api/data/reviewed-catalog-aliases.json",
        "api/data/lyric-performers.json"
      ]
    },
    {
      "entry": "api/song-library.js",
      "maxDuration": 300,
      "includeFiles": [
        "node_modules/kuromoji/dict/**",
        "node_modules/kuromoji/NOTICE.md",
        "node_modules/kuromoji/LICENSE-2.0.txt",
        "node_modules/kuroshiro/LICENSE",
        "node_modules/kuroshiro-analyzer-kuromoji/LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "api/data/reviewed-catalog-aliases.json",
        "api/data/lyric-performers.json"
      ]
    },
    {
      "entry": "api/review-reports.js",
      "maxDuration": 300,
      "includeFiles": []
    },
    {
      "entry": "api/app-auth.js",
      "includeFiles": []
    },
    {
      "entry": "api/live-lyrics.js",
      "maxDuration": 15,
      "includeFiles": []
    },
    {
      "entry": "api/account.js",
      "includeFiles": []
    },
    {
      "entry": "api/membership.js",
      "includeFiles": [
        "api/data/apple-pki/*.cer"
      ]
    },
    {
      "entry": "api/store-notifications.js",
      "includeFiles": [
        "api/data/apple-pki/*.cer"
      ]
    },
    {
      "entry": "api/spotify.js",
      "maxDuration": 15,
      "includeFiles": [
        "node_modules/kuromoji/dict/**",
        "node_modules/kuromoji/NOTICE.md",
        "node_modules/kuromoji/LICENSE-2.0.txt",
        "node_modules/kuroshiro/LICENSE",
        "node_modules/kuroshiro-analyzer-kuromoji/LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "api/data/reviewed-catalog-aliases.json",
        "api/data/lyric-performers.json"
      ]
    },
    {
      "entry": "api/_spotify-tick.js",
      "maxDuration": 15,
      "includeFiles": [
        "node_modules/kuromoji/dict/**",
        "node_modules/kuromoji/NOTICE.md",
        "node_modules/kuromoji/LICENSE-2.0.txt",
        "node_modules/kuroshiro/LICENSE",
        "node_modules/kuroshiro-analyzer-kuromoji/LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "api/data/reviewed-catalog-aliases.json",
        "api/data/lyric-performers.json"
      ],
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "spotify-background-tick-v1",
          "retryAfterSeconds": 2,
          "maxDeliveries": 128
        }
      ]
    },
    {
      "entry": "api/_spotify-acquire.js",
      "maxDuration": 300,
      "includeFiles": [
        "node_modules/kuromoji/dict/**",
        "node_modules/kuromoji/NOTICE.md",
        "node_modules/kuromoji/LICENSE-2.0.txt",
        "node_modules/kuroshiro/LICENSE",
        "node_modules/kuroshiro-analyzer-kuromoji/LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "api/data/reviewed-catalog-aliases.json",
        "api/data/lyric-performers.json"
      ],
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "spotify-background-acquire-v1",
          "retryAfterSeconds": 2,
          "maxDeliveries": 128
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/romanize",
      "dest": "/api/romanize"
    },
    {
      "src": "/api/music-romanize",
      "dest": "/api/music-romanize"
    },
    {
      "src": "/api/song-library",
      "dest": "/api/song-library"
    },
    {
      "src": "/api/review-reports",
      "dest": "/api/review-reports"
    },
    {
      "src": "/api/app-auth",
      "dest": "/api/app-auth"
    },
    {
      "src": "/api/live-lyrics",
      "dest": "/api/live-lyrics"
    },
    {
      "src": "/api/account",
      "dest": "/api/account"
    },
    {
      "src": "/api/membership",
      "dest": "/api/membership"
    },
    {
      "src": "/api/store-notifications",
      "dest": "/api/store-notifications"
    },
    {
      "src": "/api/spotify",
      "dest": "/api/spotify"
    }
  ],
  "crons": [
    {
      "path": "/api/review-reports",
      "schedule": "0 8 * * *"
    }
  ]
}
