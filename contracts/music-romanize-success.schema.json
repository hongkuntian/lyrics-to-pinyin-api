{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MusicRomanizeSuccessResponse",
  "type": "object",
  "required": [
    "song",
    "lines",
    "quality",
    "metadata"
  ],
  "properties": {
    "song": {
      "type": "object",
      "required": [
        "title",
        "artist",
        "id",
        "language",
        "romanization_system"
      ],
      "properties": {
        "title": {
          "type": "object",
          "required": [
            "original",
            "romanized"
          ],
          "properties": {
            "original": {
              "type": "string"
            },
            "romanized": {
              "type": "string"
            }
          }
        },
        "artist": {
          "type": "object",
          "required": [
            "original",
            "romanized"
          ],
          "properties": {
            "original": {
              "type": "string"
            },
            "romanized": {
              "type": "string"
            }
          }
        },
        "id": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "album": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "type": "string"
        },
        "romanization_system": {
          "type": "string"
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "original",
          "romanized",
          "timestamp"
        ],
        "properties": {
          "original": {
            "type": "string"
          },
          "romanized": {
            "type": "string"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "synced"
      ],
      "properties": {
        "synced": {
          "type": "boolean"
        },
        "instrumental": {
          "type": "boolean"
        },
        "partial": {
          "type": "boolean"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "timestamp",
        "version",
        "source"
      ],
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "selection_revision": {
          "type": "string"
        },
        "lyric_structure": {
          "type": "object",
          "required": [
            "version",
            "sourceRows",
            "annotations",
            "speakers",
            "occurrences"
          ],
          "properties": {
            "version": {
              "type": "string",
              "enum": [
                "lyric-annotations-1",
                "lyric-annotations-2",
                "lyric-annotations-3"
              ]
            },
            "sourceRows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "text",
                  "timestamp"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "timestamp": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "annotations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sourceIndex",
                  "kind"
                ],
                "properties": {
                  "sourceIndex": {
                    "type": "number"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "production_credit",
                      "source_credit",
                      "performer_cue",
                      "instrumental_marker",
                      "empty"
                    ]
                  }
                }
              }
            },
            "speakers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "sourceLabel",
                  "displayName"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "sourceLabel": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  }
                }
              }
            },
            "occurrences": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sourceID",
                  "sourceIndex",
                  "sourceText",
                  "lyricText",
                  "sourcePrefix",
                  "speakerID",
                  "startsTurn"
                ],
                "properties": {
                  "sourceID": {
                    "type": "string"
                  },
                  "sourceIndex": {
                    "type": "number"
                  },
                  "sourceText": {
                    "type": "string"
                  },
                  "lyricText": {
                    "type": "string"
                  },
                  "sourcePrefix": {
                    "type": "string"
                  },
                  "speakerID": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "startsTurn": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "recording_match": {
          "type": "object",
          "required": [
            "method",
            "catalog_id",
            "artist",
            "title",
            "duration"
          ],
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "catalog_alias",
                "metadata_alias",
                "metadata_equivalence"
              ]
            },
            "catalog_id": {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            "artist": {
              "type": "string"
            },
            "album": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "duration": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "catalog_resolution": {
          "type": "object",
          "required": [
            "version",
            "method",
            "requested",
            "canonical_recording_id",
            "canonical_context",
            "catalog_items"
          ],
          "properties": {
            "version": {
              "type": "string",
              "enum": [
                "catalog-recording-1"
              ]
            },
            "method": {
              "type": "string",
              "enum": [
                "same_catalog_id",
                "catalog_equivalent",
                "reviewed_alias"
              ]
            },
            "requested": {
              "type": "object",
              "required": [
                "catalog_id",
                "storefront"
              ],
              "properties": {
                "catalog_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "storefront": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "canonical_recording_id": {
              "type": "string",
              "pattern": "^apple:[0-9]{1,20}$"
            },
            "canonical_context": {
              "type": "object",
              "required": [
                "title",
                "artist"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "artist": {
                  "type": "string"
                }
              }
            },
            "catalog_items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "catalog_id",
                  "storefront",
                  "provenance"
                ],
                "properties": {
                  "catalog_id": {
                    "type": "string",
                    "pattern": "^[0-9]{1,20}$"
                  },
                  "storefront": {
                    "type": "string",
                    "pattern": "^[a-z]{2}$"
                  },
                  "provenance": {
                    "type": "string",
                    "enum": [
                      "apple_music",
                      "itunes"
                    ]
                  }
                }
              }
            },
            "isrc": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "accepted_request": {
              "type": "object",
              "required": [
                "catalog_id",
                "artist",
                "title",
                "album",
                "duration"
              ],
              "properties": {
                "catalog_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "artist": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "album": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "duration": {
                  "type": "number"
                }
              }
            }
          }
        },
        "language_details": {
          "type": "object",
          "required": [
            "version",
            "primary",
            "languages",
            "scripts",
            "mixed",
            "confidence",
            "pronunciation_language",
            "pronunciation_basis",
            "lines"
          ],
          "properties": {
            "version": {
              "type": "number",
              "enum": [
                1
              ]
            },
            "primary": {
              "type": "string"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "scripts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mixed": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string"
            },
            "pronunciation_language": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "pronunciation_basis": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sourceID",
                  "language",
                  "confidence"
                ],
                "properties": {
                  "sourceID": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "timing_quality": {
          "type": "object",
          "required": [
            "usable",
            "coverage",
            "alignment"
          ],
          "properties": {
            "usable": {
              "type": "boolean"
            },
            "coverage": {
              "type": "number"
            },
            "alignment": {
              "type": "string",
              "enum": [
                "provider",
                "listening_reviewed"
              ]
            }
          }
        }
      }
    },
    "song_details": {
      "type": "object",
      "required": [
        "catalog_id",
        "source_id",
        "source",
        "credits"
      ],
      "properties": {
        "catalog_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "contributors",
              "source"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "contributors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "type": "string"
              },
              "instrument": {
                "type": "string"
              },
              "original": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "provider_translation": {
      "type": "object",
      "required": [
        "language",
        "source",
        "kind",
        "lines"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "en"
          ]
        },
        "source": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "provider"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sourceID",
              "sourceText",
              "text",
              "original"
            ],
            "properties": {
              "sourceID": {
                "type": "string"
              },
              "sourceText": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "original": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
