{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Song library v1 response",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "version",
        "state"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "const": "missing"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "state",
        "revisionID"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "const": "unchanged"
        },
        "revisionID": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "state",
        "document"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "const": "ready"
        },
        "document": {
          "type": "object",
          "required": [
            "id",
            "recordingKey",
            "sourceHash",
            "selectionRevision",
            "response",
            "structure"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "recordingKey": {
              "type": "string"
            },
            "sourceHash": {
              "type": "string"
            },
            "selectionRevision": {
              "type": "string"
            },
            "response": {
              "type": "object",
              "required": [
                "song",
                "lines",
                "metadata",
                "quality"
              ],
              "properties": {
                "song": {
                  "type": "object"
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "original",
                      "romanized",
                      "timestamp"
                    ],
                    "properties": {
                      "original": {
                        "type": "string"
                      },
                      "romanized": {
                        "type": "string"
                      },
                      "timestamp": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                },
                "metadata": {
                  "type": "object"
                },
                "quality": {
                  "type": "object"
                }
              }
            },
            "structure": {
              "type": "object",
              "required": [
                "version",
                "speakers",
                "occurrences"
              ],
              "properties": {
                "speakers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "sourceLabel",
                      "displayName"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "sourceLabel": {
                        "type": "string"
                      },
                      "displayName": {
                        "type": "string"
                      }
                    }
                  }
                },
                "occurrences": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "sourceID",
                      "sourceText",
                      "lyricText",
                      "speakerID",
                      "startsTurn",
                      "sourcePrefix"
                    ],
                    "properties": {
                      "sourceID": {
                        "type": "string"
                      },
                      "sourceText": {
                        "type": "string"
                      },
                      "lyricText": {
                        "type": "string"
                      },
                      "speakerID": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "startsTurn": {
                        "type": "boolean"
                      },
                      "sourcePrefix": {
                        "type": "string"
                      }
                    }
                  }
                },
                "version": {
                  "const": "source-speakers-1"
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "state",
        "translation"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "const": "ready"
        },
        "translation": {
          "type": "object",
          "required": [
            "id",
            "recipe",
            "lines",
            "sourceNotes",
            "target",
            "notesLanguage",
            "documentID",
            "sourceHash"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "recipe": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sourceID",
                  "lyricText",
                  "text",
                  "speakerID",
                  "startsTurn"
                ],
                "properties": {
                  "sourceID": {
                    "type": "string"
                  },
                  "lyricText": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "speakerID": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "startsTurn": {
                    "type": "boolean"
                  }
                }
              }
            },
            "sourceNotes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sourceID",
                  "sourceQuote",
                  "kind",
                  "explanation"
                ],
                "properties": {
                  "sourceID": {
                    "type": "string"
                  },
                  "sourceQuote": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "uncertain_source",
                      "ambiguous_reading"
                    ]
                  },
                  "explanation": {
                    "type": "string"
                  }
                }
              }
            },
            "target": {
              "enum": [
                "en",
                "fr",
                "es",
                "zh-Hans",
                "zh-Hant"
              ]
            },
            "notesLanguage": {
              "enum": [
                "en",
                "fr",
                "es",
                "zh-Hans",
                "zh-Hant"
              ]
            },
            "documentID": {
              "type": "string"
            },
            "sourceHash": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "state"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "const": "loading_lyrics"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "state",
        "job"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "const": "preparing"
        },
        "job": {
          "type": "object",
          "required": [
            "id",
            "state",
            "documentID",
            "target",
            "errorCode"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "state": {
              "enum": [
                "queued",
                "running",
                "ready",
                "failed",
                "unknown"
              ]
            },
            "documentID": {
              "type": "string"
            },
            "target": {
              "enum": [
                "en",
                "fr",
                "es",
                "zh-Hans",
                "zh-Hant"
              ]
            },
            "errorCode": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "state",
        "job"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "ready",
            "failed",
            "unknown"
          ]
        },
        "job": {
          "type": "object",
          "required": [
            "id",
            "state",
            "documentID",
            "target",
            "errorCode"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "state": {
              "enum": [
                "queued",
                "running",
                "ready",
                "failed",
                "unknown"
              ]
            },
            "documentID": {
              "type": "string"
            },
            "target": {
              "enum": [
                "en",
                "fr",
                "es",
                "zh-Hans",
                "zh-Hant"
              ]
            },
            "errorCode": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "report"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "report": {
          "type": "object",
          "required": [
            "id",
            "status"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "const": "pending"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "code"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "code": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "state",
        "explanation"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "const": "ready"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "id",
                "documentID",
                "translationID",
                "sourceID",
                "lower",
                "upper",
                "recipe",
                "meaning",
                "context",
                "grammar",
                "uncertainty",
                "sourceQuote"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "documentID": {
                  "type": "string"
                },
                "translationID": {
                  "type": "string"
                },
                "sourceID": {
                  "type": "string"
                },
                "lower": {
                  "type": "integer",
                  "minimum": 0
                },
                "upper": {
                  "type": "integer",
                  "minimum": 1
                },
                "recipe": {
                  "const": "study-occurrence-2"
                },
                "meaning": {
                  "type": "string"
                },
                "context": {
                  "type": "string"
                },
                "grammar": {
                  "type": "string"
                },
                "uncertainty": {
                  "type": "string"
                },
                "sourceQuote": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "id",
                "documentID",
                "translationID",
                "sourceID",
                "lower",
                "upper",
                "recipe",
                "meaning",
                "context",
                "grammar",
                "uncertainty",
                "sourceQuote",
                "contractVersion",
                "explanationLanguage",
                "studyText",
                "selection"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "documentID": {
                  "type": "string"
                },
                "translationID": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sourceID": {
                  "type": "string"
                },
                "lower": {
                  "type": "integer",
                  "minimum": 0
                },
                "upper": {
                  "type": "integer",
                  "minimum": 1
                },
                "recipe": {
                  "enum": ["study-text-1", "study-text-2"]
                },
                "meaning": {
                  "type": "string"
                },
                "context": {
                  "type": "string"
                },
                "grammar": {
                  "type": "string"
                },
                "uncertainty": {
                  "type": "string"
                },
                "sourceQuote": {
                  "type": "string"
                },
                "contractVersion": {
                  "const": 2
                },
                "explanationLanguage": {
                  "enum": [
                    "en",
                    "fr",
                    "es",
                    "zh-Hans",
                    "zh-Hant"
                  ]
                },
                "studyText": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "layer",
                        "revisionID",
                        "occurrenceID"
                      ],
                      "properties": {
                        "layer": {
                          "const": "original"
                        },
                        "revisionID": {
                          "type": "string"
                        },
                        "occurrenceID": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "layer",
                        "revisionID",
                        "occurrenceID",
                        "target"
                      ],
                      "properties": {
                        "layer": {
                          "const": "translation"
                        },
                        "revisionID": {
                          "type": "string"
                        },
                        "occurrenceID": {
                          "type": "string"
                        },
                        "target": {
                          "enum": [
                            "en",
                            "fr",
                            "es",
                            "zh-Hans",
                            "zh-Hant"
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "selection": {
                  "type": "object",
                  "required": [
                    "offsetUnit",
                    "ranges",
                    "textHash"
                  ],
                  "properties": {
                    "offsetUnit": {
                      "const": "grapheme"
                    },
                    "textHash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "ranges": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "lower",
                          "upper"
                        ],
                        "properties": {
                          "lower": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "upper": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "state"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "const": "preparing"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "version",
        "capabilities"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "capabilities": {
          "type": "object",
          "required": [
            "version",
            "targets",
            "translationDirections",
            "explanationDirections",
            "study",
            "automaticCorrectionTargets"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "tag",
                  "name"
                ],
                "properties": {
                  "tag": {
                    "enum": [
                      "en",
                      "fr",
                      "es",
                      "zh-Hans",
                      "zh-Hant"
                    ]
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "translationDirections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "explanationDirections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "study": {
                "type": "object"
              },
              "automaticCorrectionTargets": {
                "type": "array",
                "items": {
                  "enum": [
                    "en",
                    "fr",
                    "es",
                    "zh-Hans",
                    "zh-Hant"
                  ]
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
