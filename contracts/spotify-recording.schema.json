{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spotify recording v2 (semantic scalar/control validation also enforced by recordingRequest)",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "provider": {
      "const": "spotify"
    },
    "item_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{22}$"
    },
    "requested_item_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{22}$"
    },
    "market": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "origin": {
          "const": "spotify"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "artists": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "album": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200000
        },
        "isrc": {
          "type": "string",
          "pattern": "^[A-Z]{2}[A-Z0-9]{3}[0-9]{7}$"
        },
        "explicit": {
          "type": "boolean"
        },
        "artist_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{22}$"
          }
        }
      },
      "required": [
        "origin",
        "title",
        "artists",
        "duration_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "provider",
    "item_id",
    "metadata"
  ],
  "additionalProperties": false
}
